# Example environment for Malten. Copy to /home/malten/.env on the server and
# fill in your values. systemd reads this file (EnvironmentFile), so use plain
# KEY=value lines — no `export`, no shell expansion, no surrounding quotes.
#
#   sudo -u malten cp deploy/env.example /home/malten/.env
#   sudo -u malten chmod 600 /home/malten/.env   # it holds your API key
#   sudo -u malten $EDITOR /home/malten/.env

# --- Model -------------------------------------------------------------------
# Use the real Claude backend in production.
MALTEN_LLM=claude
# Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override the model (default claude-opus-4-8; a Sonnet id is cheaper).
# MALTEN_MODEL=claude-sonnet-5

# --- Server ------------------------------------------------------------------
# Bind to localhost only; nginx terminates TLS and proxies to this address.
MALTEN_ADDR=127.0.0.1:8080
# SQLite database path.
MALTEN_DB=/home/malten/malten.db
